# Production: point the map at the Martin MVT tile endpoint.
# When unset, the app falls back to /plots.geojson (public/) — good for local dev.
VITE_TILES_URL=
# Example: VITE_TILES_URL=http://localhost:3001/plots/{z}/{x}/{y}

# Backend API base (plots detail, edit, rename, audit)
VITE_API_URL=http://localhost:3000
